  <circle cx="203" cy="128" r="24" fill="none" stroke="#2c1600" stroke-width="8"/>
  
  <polygon points="128,105 133,121 151,128 133,135 128,151 123,135 105,128 123,121" fill="#FFD700" stroke="#2c1600" stroke-width="3" />
