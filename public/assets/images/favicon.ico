  <circle cx="128" cy="128" r="115" fill="url(#orangeGlow)" mask="url(#reelHoles)" />
  
  <circle cx="128" cy="128" r="115" fill="none" stroke="#2c1600" stroke-width="12" />
  
  <circle cx="128" cy="128" r="75" fill="none" stroke="#2c1600" stroke-width="10" />
